---
import { siteConfig } from '../data/siteConfig';

const defaultWaText = encodeURIComponent(
  `Halo ${siteConfig.brandName}, saya mau tanya soal cuci sepatu.`
);
const waHref = `https://wa.me/${siteConfig.whatsapp}?text=${defaultWaText}`;
---

<a
  id="floating-wa"
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Chat WhatsApp ${siteConfig.brandName}`}
  class="pointer-events-none fixed right-4 bottom-4 z-40 inline-flex translate-y-3 items-center gap-2 rounded-full bg-emerald-600 px-4 py-3 text-sm font-bold text-white opacity-0 shadow-md transition-all duration-200 hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    class="h-5 w-5 shrink-0"
    aria-hidden="true"
  >
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2Zm5.78 14.08c-.24.68-1.42 1.3-1.97 1.38-.51.08-1.15.11-1.85-.11-.43-.14-.98-.32-1.69-.63-2.97-1.28-4.91-4.27-5.06-4.47-.15-.2-1.21-1.61-1.21-3.07 0-1.46.77-2.18 1.04-2.48.27-.3.59-.37.79-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.24.59.84 2.04.91 2.19.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.05 1.13 1.01 2.09 1.32 2.39 1.47.3.15.47.12.64-.07.17-.2.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.96.3.15.5.22.57.34.07.12.07.72-.17 1.4Z"
    />
  </svg>
  <span>Chat WA</span>
</a>

<script>
  const floatingWa = document.getElementById('floating-wa');
  const heroSection = document.getElementById('hero');
  const submitBtn = document.getElementById('booking-submit-btn');

  if (floatingWa && heroSection) {
    let pastHero = false;
    let submitVisible = false;

    const syncVisibility = () => {
      const shouldShow = pastHero && !submitVisible;
      floatingWa.classList.toggle('opacity-100', shouldShow);
      floatingWa.classList.toggle('translate-y-0', shouldShow);
      floatingWa.classList.toggle('pointer-events-auto', shouldShow);
      floatingWa.classList.toggle('opacity-0', !shouldShow);
      floatingWa.classList.toggle('translate-y-3', !shouldShow);
      floatingWa.classList.toggle('pointer-events-none', !shouldShow);
    };

    const heroObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          pastHero = !entry.isIntersecting;
          syncVisibility();
        });
      },
      { threshold: 0.1 }
    );
    heroObserver.observe(heroSection);

    if (submitBtn) {
      const submitObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            submitVisible = entry.isIntersecting;
            syncVisibility();
          });
        },
        { threshold: 0.1 }
      );
      submitObserver.observe(submitBtn);
    }
  }
</script>
