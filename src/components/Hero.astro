---
import { siteConfig } from '../data/siteConfig';

const trustBadges = [
  'Aman untuk Suede & Mesh',
  'Antar-Jemput Praktis',
  'Garansi Cuci Ulang',
];

const quickHighlights = [
  { value: 'Rp30rb', label: 'Mulai dari' },
  { value: '1–3 Hari', label: 'Selesai' },
  { value: '48 Jam', label: 'Garansi' },
];

const marqueeItems = [
  'AMAN UNTUK SUEDE & NUBUCK',
  'FOTO HASIL VIA WA DULU',
  'BLOWER SUHU RUANG',
  'GARANSI CUCI ULANG 48 JAM',
  'TANPA DP CUCI STANDAR',
  'ANTAR-JEMPUT PRAKTIS',
];
---

<section id="hero" class="relative overflow-hidden bg-zinc-50">
  <!-- Subtle cleaning bubbles -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span
      class="clean-bubble absolute bottom-16 left-[7%] h-7 w-7 rounded-full border border-emerald-600/20 bg-emerald-50/60"
      style="--bubble-duration: 9s; --bubble-delay: 0s;"
    ></span>
    <span
      class="clean-bubble absolute bottom-24 left-[30%] h-4 w-4 rounded-full border border-emerald-600/25 bg-white/80"
      style="--bubble-duration: 11s; --bubble-delay: 2.2s;"
    ></span>
    <span
      class="clean-bubble absolute bottom-14 right-[20%] h-9 w-9 rounded-full border border-emerald-600/15 bg-emerald-50/50"
      style="--bubble-duration: 12s; --bubble-delay: 1.1s;"
    ></span>
    <span
      class="clean-bubble absolute bottom-28 right-[7%] h-5 w-5 rounded-full border border-emerald-600/25 bg-white/80"
      style="--bubble-duration: 8.5s; --bubble-delay: 3.4s;"
    ></span>
  </div>

  <div class="relative mx-auto max-w-5xl px-4 py-9 sm:px-6 sm:py-14">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Copy Utama -->
      <div class="lg:col-span-7">
        <div class="inline-flex max-w-full flex-wrap items-center gap-1.5 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-semibold text-zinc-700 shadow-xs">
          <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-600"></span>
          </span>
          <span>Slot Jemput Tersedia</span>
          <span class="text-zinc-300" aria-hidden="true">•</span>
          <span class="truncate text-zinc-500">{siteConfig.serviceArea}</span>
        </div>

        <h1 class="mt-4 text-3xl font-extrabold leading-[1.15] tracking-tight text-zinc-900 sm:text-5xl sm:leading-[1.1]">
          Sepatu bersih lagi, bahan tetap aman, tinggal tunggu di rumah.
        </h1>

        <p class="mt-3.5 text-sm leading-relaxed text-zinc-600 sm:text-base">
          Cuci manual khusus suede, mesh, &amp; canvas. <strong class="font-semibold text-zinc-900">Foto hasil dikirim ke WA dulu untuk kamu ACC</strong> sebelum diantar balik.
        </p>

        <div class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:items-center">
          <a
            href="#booking"
            data-burst
            class="cta-shine inline-flex min-h-12 items-center justify-center rounded-xl bg-emerald-600 px-6 py-3 text-center text-sm font-bold text-white shadow-sm transition-all hover:bg-emerald-700 hover:shadow-md active:scale-[0.98] sm:text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
          >
            Pesan Jemput Sekarang
          </a>
          <a
            href="#diagnosa"
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-zinc-300 bg-white px-5 py-3 text-center text-sm font-semibold text-zinc-900 shadow-xs transition-all hover:border-zinc-400 hover:bg-zinc-100 active:scale-[0.98] sm:text-base"
          >
            Cek Paket Sepatumu
          </a>
        </div>

        {
          siteConfig.promoText && (
            <p class="mt-3.5 inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 sm:text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{siteConfig.promoText}</span>
            </p>
          )
        }

        <ul
          aria-label="Keunggulan layanan"
          class="mt-6 flex flex-wrap gap-x-5 gap-y-2.5 border-t border-zinc-200 pt-5"
        >
          {
            trustBadges.map((badge) => (
              <li class="flex items-center gap-2 text-xs font-semibold text-zinc-800 sm:text-sm">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-3.5 w-3.5"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <span>{badge}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Animated Sneaker Clean-Sweep Visual Card -->
      <div class="lg:col-span-5">
        <div
          data-tilt
          class="rounded-2xl border border-zinc-200 bg-white p-4 shadow-md sm:p-5"
        >
          <div class="relative overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 px-3 pt-4 pb-3">
            <div class="flex items-center justify-between text-[11px] font-bold">
              <span class="rounded-md bg-zinc-900 px-2 py-0.5 text-white">LIVE CLEAN DEMO</span>
              <span class="text-emerald-700">Manual • pH Netral</span>
            </div>

            <div class="relative mx-auto mt-2 flex h-36 w-full max-w-[260px] items-center justify-center sm:h-40 sm:max-w-[280px]">
              <div
                class="shoe-shadow absolute bottom-2 h-3 w-44 rounded-full bg-zinc-900"
                aria-hidden="true"
              ></div>

              <div class="shoe-float relative h-36 w-full">
                <!-- Dirty Sneaker -->
                <svg
                  viewBox="0 0 320 180"
                  fill="none"
                  class="absolute inset-0 h-full w-full"
                  aria-hidden="true"
                >
                  <path
                    d="M34 128c0-14 10-26 24-29l36-8 34-36c6-6 15-6 21 0l14 14 18-11c7-4 15-2 20 4l27 36h46c18 0 32 14 32 32v12H34v-14z"
                    fill="#d6d3d1"
                    stroke="#78716c"
                    stroke-width="3.5"
                    stroke-linejoin="round"
                  />
                  <rect
                    x="32"
                    y="138"
                    width="276"
                    height="20"
                    rx="8"
                    fill="#d4c7a1"
                    stroke="#78716c"
                    stroke-width="3.5"
                  />
                  <ellipse cx="105" cy="116" rx="26" ry="11" fill="#a8a29e" opacity="0.8" />
                  <ellipse cx="206" cy="122" rx="32" ry="10" fill="#8c7a6b" opacity="0.65" />
                  <circle cx="268" cy="126" r="12" fill="#9a8470" opacity="0.7" />
                  <ellipse cx="160" cy="148" rx="40" ry="6" fill="#a18a62" opacity="0.75" />
                  <path
                    d="M156 80l18 10M172 72l18 10M187 65l17 10"
                    stroke="#78716c"
                    stroke-width="4"
                    stroke-linecap="round"
                  />
                </svg>

                <!-- Clean Sneaker -->
                <div class="clean-sweep-layer absolute inset-0">
                  <svg
                    viewBox="0 0 320 180"
                    fill="none"
                    class="h-full w-full"
                    role="img"
                    aria-label="Ilustrasi sepatu berubah dari kotor menjadi bersih"
                  >
                    <path
                      d="M34 128c0-14 10-26 24-29l36-8 34-36c6-6 15-6 21 0l14 14 18-11c7-4 15-2 20 4l27 36h46c18 0 32 14 32 32v12H34v-14z"
                      fill="#ffffff"
                      stroke="#18181b"
                      stroke-width="3.5"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M112 122l44-22"
                      stroke="#059669"
                      stroke-width="7"
                      stroke-linecap="round"
                    />
                    <path
                      d="M126 130l38-18"
                      stroke="#10b981"
                      stroke-width="4"
                      stroke-linecap="round"
                    />
                    <rect
                      x="32"
                      y="138"
                      width="276"
                      height="20"
                      rx="8"
                      fill="#ffffff"
                      stroke="#18181b"
                      stroke-width="3.5"
                    />
                    <line
                      x1="46"
                      y1="148"
                      x2="294"
                      y2="148"
                      stroke="#e4e4e7"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                    <path
                      d="M156 80l18 10M172 72l18 10M187 65l17 10"
                      stroke="#18181b"
                      stroke-width="4"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>

                <!-- Scan Beam -->
                <div
                  class="clean-sweep-beam pointer-events-none absolute inset-y-3 w-1 rounded-full bg-emerald-600"
                  aria-hidden="true"
                ></div>

                <!-- Popping Sparkles -->
                <svg
                  viewBox="0 0 24 24"
                  fill="#059669"
                  class="sparkle-pop pointer-events-none absolute top-2 right-5 h-5 w-5"
                  style="--sparkle-delay: 0.4s;"
                  aria-hidden="true"
                >
                  <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z" />
                </svg>
                <svg
                  viewBox="0 0 24 24"
                  fill="#10b981"
                  class="sparkle-pop pointer-events-none absolute bottom-8 left-3 h-4 w-4"
                  style="--sparkle-delay: 1.1s;"
                  aria-hidden="true"
                >
                  <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z" />
                </svg>
                <svg
                  viewBox="0 0 24 24"
                  fill="#059669"
                  class="sparkle-pop pointer-events-none absolute top-8 left-12 h-3.5 w-3.5"
                  style="--sparkle-delay: 1.7s;"
                  aria-hidden="true"
                >
                  <path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4L12 2z" />
                </svg>
              </div>
            </div>
          </div>

          <p class="mt-3.5 text-center text-xs font-semibold text-zinc-700">
            Foto hasil via WA dulu • Tanpa DP cuci standar
          </p>

          <div class="mt-3 grid grid-cols-3 gap-2 border-t border-zinc-100 pt-3 text-center">
            {
              quickHighlights.map((item) => (
                <div class="rounded-xl bg-zinc-50 px-2 py-2">
                  <p class="text-sm font-extrabold text-zinc-900">{item.value}</p>
                  <p class="text-[11px] font-medium text-zinc-500">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Crisp High-Contrast Kinetic USP Marquee -->
  <div class="marquee-wrap overflow-hidden border-y border-zinc-800 bg-zinc-900 py-2.5 text-white">
    <div class="marquee-track">
      {
        [0, 1].map((dup) => (
          <div class="flex shrink-0 items-center" aria-hidden={dup === 1 ? 'true' : undefined}>
            {marqueeItems.map((text) => (
              <span class="inline-flex items-center gap-3 px-4 text-[11px] font-bold tracking-wider whitespace-nowrap sm:px-5 sm:text-xs">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                <span>{text}</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
