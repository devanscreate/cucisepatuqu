---
import { siteConfig } from '../data/siteConfig';

const trustBadges = [
  'Aman untuk Suede & Mesh',
  'Antar-Jemput Praktis',
  'Garansi Cuci Ulang',
];
---

<section id="hero" class="border-b border-zinc-200 bg-zinc-50">
  <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="max-w-2xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-semibold text-zinc-700">
        <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
        Area layanan: {siteConfig.serviceArea}
      </p>

      <h1 class="mt-5 text-3xl font-extrabold leading-tight tracking-tight text-zinc-900 sm:text-5xl sm:leading-[1.12]">
        Sepatu kotor balik bersih, aman buat bahan sensitif, tinggal tunggu di rumah.
      </h1>

      <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg">
        Kami bersihkan manual sesuai jenis bahan—dari suede, nubuck, mesh, sampai canvas—tanpa merusak lem atau bikin warna pudar. Malas keluar? Kurir kami jemput dan antar lagi ke pintu kamu.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#booking"
          class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-6 py-3.5 text-center text-base font-bold text-white transition-colors hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
        >
          Pesan Jemput Sekarang
        </a>
        <a
          href="#harga"
          class="inline-flex items-center justify-center rounded-xl border border-zinc-300 bg-white px-6 py-3.5 text-center text-base font-semibold text-zinc-900 transition-colors hover:bg-zinc-100"
        >
          Lihat Daftar Harga
        </a>
      </div>

      <ul
        aria-label="Keunggulan layanan"
        class="mt-8 grid grid-cols-1 gap-3 border-t border-zinc-200 pt-6 sm:grid-cols-3"
      >
        {
          trustBadges.map((badge) => (
            <li class="flex items-center gap-2.5 text-sm font-semibold text-zinc-800">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
              <span>{badge}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
