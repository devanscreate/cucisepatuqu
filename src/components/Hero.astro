---
import { siteConfig } from '../data/siteConfig';

const trustBadges = [
  'Aman untuk Suede & Mesh',
  'Antar-Jemput Praktis',
  'Garansi Cuci Ulang',
];

const quickHighlights = [
  { value: 'Rp30rb', label: 'Mulai dari' },
  { value: '1–3 Hari', label: 'Estimasi jadi' },
  { value: '48 Jam', label: 'Garansi ulang' },
];
---

<section id="hero" class="relative overflow-hidden border-b border-zinc-200 bg-zinc-50">
  <!-- Subtle cleaning bubbles (pure CSS, zero visual clutter) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span
      class="clean-bubble absolute bottom-8 left-[8%] h-7 w-7 rounded-full border border-emerald-600/20 bg-emerald-50/50"
      style="--bubble-duration: 9s; --bubble-delay: 0s;"
    ></span>
    <span
      class="clean-bubble absolute bottom-16 left-[28%] h-4 w-4 rounded-full border border-emerald-600/25 bg-white/70"
      style="--bubble-duration: 11s; --bubble-delay: 2.2s;"
    ></span>
    <span
      class="clean-bubble absolute bottom-6 right-[22%] h-9 w-9 rounded-full border border-emerald-600/15 bg-emerald-50/40"
      style="--bubble-duration: 12s; --bubble-delay: 1.1s;"
    ></span>
    <span
      class="clean-bubble absolute bottom-20 right-[8%] h-5 w-5 rounded-full border border-emerald-600/25 bg-white/80"
      style="--bubble-duration: 8.5s; --bubble-delay: 3.4s;"
    ></span>
  </div>

  <div class="relative mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-20">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
      <!-- Copy Utama -->
      <div class="lg:col-span-7">
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-600"></span>
          </span>
          <span>Slot Jemput Hari Ini Tersedia</span>
          <span class="text-zinc-300" aria-hidden="true">•</span>
          <span class="text-zinc-500">{siteConfig.serviceArea}</span>
        </div>

        <h1 class="mt-5 text-3xl font-extrabold leading-tight tracking-tight text-zinc-900 sm:text-5xl sm:leading-[1.12]">
          Sepatu kotor balik bersih, aman buat bahan sensitif, tinggal tunggu di rumah.
        </h1>

        <p class="mt-4 text-base leading-relaxed text-zinc-600 sm:text-lg">
          Dicuci manual sesuai bahan (suede, nubuck, mesh, canvas) tanpa merusak lem. Sebelum dikirim balik, <strong class="font-semibold text-zinc-900">foto hasil dikirim ke WA dulu untuk kamu ACC</strong>.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href="#booking"
            class="cta-shine inline-flex items-center justify-center rounded-xl bg-emerald-600 px-6 py-3.5 text-center text-base font-bold text-white transition-all hover:bg-emerald-700 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
          >
            Pesan Jemput Sekarang
          </a>
          <a
            href="#diagnosa"
            class="inline-flex items-center justify-center rounded-xl border border-zinc-300 bg-white px-6 py-3.5 text-center text-base font-semibold text-zinc-900 transition-all hover:border-zinc-400 hover:bg-zinc-100 active:scale-[0.98]"
          >
            Cek Paket Sepatumu
          </a>
        </div>

        {
          siteConfig.promoText && (
            <p class="mt-4 inline-flex items-center gap-2 text-xs font-semibold text-emerald-700 sm:text-sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{siteConfig.promoText}</span>
            </p>
          )
        }

        <ul
          aria-label="Keunggulan layanan"
          class="mt-8 grid grid-cols-1 gap-3 border-t border-zinc-200 pt-6 sm:grid-cols-3"
        >
          {
            trustBadges.map((badge) => (
              <li class="flex items-center gap-2.5 text-sm font-semibold text-zinc-800">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <span>{badge}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Kartu Ringkas USP & Quick Stats -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 sm:p-6">
          <div class="flex items-center justify-between gap-2 border-b border-zinc-100 pb-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
                Beda dari Cuci Biasa
              </p>
              <p class="mt-0.5 text-base font-extrabold text-zinc-900">
                Foto Dulu, ACC Baru Kirim Balik
              </p>
            </div>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="h-5 w-5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"
                />
              </svg>
            </span>
          </div>

          <ul class="mt-4 space-y-3 text-sm text-zinc-700">
            <li class="flex items-start gap-2.5">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
              <span>Laporan foto kondisi awal via WA begitu sepatu sampai workshop.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
              <span>Pengeringan blower suhu ruang—bukan dijemur matahari agar lem awet.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-emerald-600" aria-hidden="true"></span>
              <span><strong class="font-semibold text-zinc-900">Tanpa DP</strong> untuk cuci standar. Bayar setelah sepatu dicek atau diterima.</span>
            </li>
          </ul>

          <div class="mt-5 grid grid-cols-3 gap-2 border-t border-zinc-100 pt-4 text-center">
            {
              quickHighlights.map((item) => (
                <div class="rounded-xl bg-zinc-50 px-2 py-2.5">
                  <p class="text-sm font-extrabold text-zinc-900 sm:text-base">{item.value}</p>
                  <p class="mt-0.5 text-[11px] font-medium text-zinc-500">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
