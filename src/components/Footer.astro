---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 bg-white pt-10 pb-24 sm:pb-12">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-start">
      <div>
        <a
          href="#top"
          class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight text-zinc-900"
        >
          <span
            class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-600"
            aria-hidden="true"
          ></span>
          <span>{siteConfig.brandName}</span>
        </a>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-zinc-600">
          {siteConfig.address}
        </p>
        <p class="mt-1 text-xs text-zinc-500">{siteConfig.hours}</p>
      </div>

      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-zinc-600">
        <a href="#hasil" class="hover:text-zinc-900">Hasil Cuci</a>
        <a href="#harga" class="hover:text-zinc-900">Daftar Harga</a>
        <a href="#booking" class="hover:text-zinc-900">Pesan Jemput</a>
        <a href="#lokasi-faq" class="hover:text-zinc-900">Lokasi &amp; FAQ</a>
      </div>
    </div>

    <div class="mt-8 border-t border-zinc-200 pt-6 text-xs text-zinc-500">
      &copy; {currentYear} {siteConfig.brandName}. Semua hak dilindungi.
    </div>
  </div>
</footer>
