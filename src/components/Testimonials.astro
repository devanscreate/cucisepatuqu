---
import { testimonials } from '../data/testimonials';
---

<section class="border-t border-zinc-200 bg-white py-14 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Kata Pelanggan
      </p>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
        Yang sudah coba cuci di sini
      </h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        testimonials.map((item, idx) => (
          <figure
            data-reveal
            style={`--reveal-delay: ${idx * 80}ms;`}
            class="flex flex-col justify-between rounded-2xl border border-zinc-200 bg-zinc-50 p-5"
          >
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-md bg-white px-2.5 py-1 text-xs font-bold text-zinc-800 border border-zinc-200">
                  {item.shoeType}
                </span>
                <span class="text-xs font-semibold text-emerald-700">
                  {item.serviceUsed}
                </span>
              </div>

              <blockquote class="mt-4 text-sm leading-relaxed text-zinc-700">
                "{item.quote}"
              </blockquote>
            </div>

            <figcaption class="mt-5 flex items-center justify-between border-t border-zinc-200 pt-3.5 text-xs">
              <span class="font-bold text-zinc-900">{item.name}</span>
              <span class="text-zinc-500">{item.area}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
