---
import { siteConfig } from '../data/siteConfig';

const comparisons = [
  {
    aspect: 'Pengeringan',
    ordinary: 'Jemur matahari (lem cepat lepas)',
    ours: 'Blower suhu ruang (lem tetap awet)',
  },
  {
    aspect: 'Suede & Nubuck',
    ordinary: 'Direndam air & sikat kasar',
    ours: 'Minim air + sikat bulu halus khusus',
  },
  {
    aspect: 'Update Hasil',
    ordinary: 'Tanpa kabar sampai selesai',
    ours: 'Foto hasil dikirim ke WA dulu untuk ACC',
  },
  {
    aspect: 'Jaminan',
    ordinary: 'Tidak ada garansi ulang',
    ours: 'Garansi cuci ulang gratis 48 jam',
  },
];

const steps = [
  { num: '01', title: 'Pesan 1 Menit', desc: 'Pilih paket, kirim ke WA. Tanpa DP.' },
  { num: '02', title: 'Kurir Jemput', desc: 'Jemput di rumah atau titip satpam.' },
  { num: '03', title: 'Cuci & Foto WA', desc: 'Dicuci manual, foto hasil kirim ke WA.' },
  { num: '04', title: 'Antar & Bayar', desc: 'Sepatu balik bersih, bayar setelah dicek.' },
];
---

<section class="border-t border-zinc-200 bg-white py-11 sm:py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <!-- Perbandingan Jujur -->
    <div class="max-w-lg" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Kenapa {siteConfig.brandName}?
      </p>
      <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
        Beda cara cuci, beda awetnya
      </h2>
    </div>

    <div
      data-reveal
      style="--reveal-delay: 80ms;"
      class="mt-6 overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-xs"
    >
      <div class="hidden grid-cols-12 border-b border-zinc-200 bg-zinc-50 px-5 py-3 text-xs font-bold uppercase tracking-wider sm:grid">
        <div class="col-span-3 text-zinc-500">Aspek</div>
        <div class="col-span-4 text-zinc-500">Cuci Asal</div>
        <div class="col-span-5 text-emerald-700">Standar {siteConfig.brandName}</div>
      </div>

      <div class="divide-y divide-zinc-200">
        {
          comparisons.map((row) => (
            <div class="grid grid-cols-1 gap-2 p-4 sm:grid-cols-12 sm:items-center sm:gap-4 sm:px-5 sm:py-4">
              <div class="sm:col-span-3">
                <p class="text-sm font-extrabold text-zinc-900">{row.aspect}</p>
              </div>

              <div class="flex items-center gap-2 text-xs text-zinc-500 sm:col-span-4 sm:text-sm">
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-[10px] font-bold text-zinc-500"
                  aria-hidden="true"
                >
                  ✕
                </span>
                <p>{row.ordinary}</p>
              </div>

              <div class="flex items-center gap-2 rounded-lg bg-emerald-50/70 px-2.5 py-2 text-xs font-semibold text-zinc-900 sm:col-span-5 sm:bg-transparent sm:p-0 sm:text-sm">
                <span
                  class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-600 text-white"
                  aria-hidden="true"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-3 w-3"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <p>{row.ours}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Alur 4 Langkah (2 kolom di HP, 4 kolom di Desktop) -->
    <div class="mt-12 sm:mt-14">
      <div class="max-w-lg" data-reveal>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
          Cara Kerja
        </p>
        <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
          Cukup 4 langkah praktis
        </h2>
      </div>

      <ol class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {
          steps.map((step, idx) => (
            <li
              data-reveal
              style={`--reveal-delay: ${idx * 70}ms;`}
              class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:border-emerald-600/50 hover:bg-white hover:shadow-md sm:p-5"
            >
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-600 text-xs font-extrabold text-white">
                {step.num}
              </span>
              <h3 class="mt-3 text-sm font-bold text-zinc-900 sm:text-base">{step.title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-zinc-600 sm:text-sm">{step.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
