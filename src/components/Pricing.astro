---
import { services } from '../data/services';
---

<section id="harga" class="border-t border-zinc-200 bg-zinc-50 py-14 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="max-w-xl" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Daftar Layanan &amp; Harga
      </p>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
        Harga transparan, tanpa biaya tersembunyi
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-zinc-600 sm:text-base">
        Pilih paket sesuai kondisi sepatu kamu. Kalau masih ragu, pilih Deep Clean dulu—nanti tim kami cek ulang saat sepatu diterima.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, idx) => (
          <article
            data-reveal
            data-tilt
            style={`--reveal-delay: ${idx * 70}ms;`}
            class:list={[
              'relative flex flex-col justify-between rounded-2xl bg-white p-6 shadow-sm hover:shadow-md',
              service.isPopular
                ? 'border-2 border-emerald-600'
                : 'border border-zinc-200 hover:border-zinc-300',
            ]}
          >
            <div>
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-bold text-zinc-900">{service.name}</h3>
                {service.isPopular && (
                  <span class="shrink-0 rounded-full bg-emerald-600 px-2.5 py-0.5 text-xs font-bold text-white">
                    Paling Laris
                  </span>
                )}
              </div>

              <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-extrabold tracking-tight text-zinc-900">
                  {service.priceLabel}
                </span>
                <span class="text-xs font-medium text-zinc-500">/ pasang</span>
              </div>

              <p class="mt-2 inline-flex items-center gap-1.5 rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-semibold text-zinc-700">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-3.5 w-3.5 text-zinc-500"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .414.336.75.75.75h4a.75.75 0 0 0 0-1.5h-3.25V5Z"
                    clip-rule="evenodd"
                  />
                </svg>
                Estimasi {service.eta}
              </p>

              <p class="mt-4 text-sm leading-relaxed text-zinc-600">
                {service.description}
              </p>

              <ul class="mt-4 space-y-2 border-t border-zinc-100 pt-4 text-xs text-zinc-700">
                {service.highlights.map((point) => (
                  <li class="flex items-start gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="mt-0.5 h-3.5 w-3.5 shrink-0 text-emerald-600"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button
              type="button"
              data-select-service={service.id}
              data-burst
              class:list={[
                'mt-6 inline-flex w-full cursor-pointer items-center justify-center rounded-xl px-4 py-3 text-sm font-bold transition-all active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600',
                service.isPopular
                  ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                  : 'bg-zinc-900 text-white hover:bg-emerald-600',
              ]}
            >
              Pilih Paket Ini
            </button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const selectButtons = document.querySelectorAll<HTMLButtonElement>('[data-select-service]');

  selectButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const serviceId = btn.dataset.selectService;
      if (!serviceId) return;

      window.dispatchEvent(
        new CustomEvent('kicksclean:prefill', {
          detail: { serviceId },
        })
      );

      document.getElementById('booking')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    });
  });
</script>
