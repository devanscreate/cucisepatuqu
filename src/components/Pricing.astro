---
import { services } from '../data/services';
---

<section id="harga" class="border-t border-zinc-200 bg-zinc-50 py-11 sm:py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="max-w-lg" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Daftar Harga
      </p>
      <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
        Transparan, tanpa biaya tersembunyi
      </h2>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {
        services.map((service, idx) => (
          <article
            data-reveal
            data-tilt
            style={`--reveal-delay: ${idx * 65}ms;`}
            class:list={[
              'relative flex flex-col justify-between rounded-2xl bg-white p-5 shadow-sm hover:shadow-md',
              service.isPopular
                ? 'border-2 border-emerald-600'
                : 'border border-zinc-200 hover:border-zinc-300',
            ]}
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-base font-bold text-zinc-900 sm:text-lg">{service.name}</h3>
                {service.isPopular ? (
                  <span class="shrink-0 rounded-full bg-emerald-600 px-2.5 py-0.5 text-[11px] font-bold text-white">
                    Paling Laris
                  </span>
                ) : (
                  <span class="shrink-0 rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold text-zinc-600">
                    {service.eta}
                  </span>
                )}
              </div>

              <div class="mt-2.5 flex items-baseline gap-1.5">
                <span class="text-2xl font-extrabold tracking-tight text-zinc-900">
                  {service.priceLabel}
                </span>
                <span class="text-xs font-medium text-zinc-500">
                  / pasang {service.isPopular ? `• ${service.eta}` : ''}
                </span>
              </div>

              <p class="mt-2.5 text-xs leading-relaxed text-zinc-600 sm:text-sm">
                {service.description}
              </p>

              <ul class="mt-3.5 space-y-1.5 border-t border-zinc-100 pt-3.5 text-xs text-zinc-700">
                {service.highlights.map((point) => (
                  <li class="flex items-center gap-2">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-3.5 w-3.5 shrink-0 text-emerald-600"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button
              type="button"
              data-select-service={service.id}
              data-burst
              class:list={[
                'mt-5 inline-flex min-h-11 w-full cursor-pointer items-center justify-center rounded-xl px-4 py-2.5 text-sm font-bold transition-all active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600',
                service.isPopular
                  ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                  : 'bg-zinc-900 text-white hover:bg-emerald-600',
              ]}
            >
              Pilih Paket Ini
            </button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const selectButtons = document.querySelectorAll<HTMLButtonElement>('[data-select-service]');

  selectButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const serviceId = btn.dataset.selectService;
      if (!serviceId) return;

      window.dispatchEvent(
        new CustomEvent('kicksclean:prefill', {
          detail: { serviceId },
        })
      );

      document.getElementById('booking')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    });
  });
</script>
