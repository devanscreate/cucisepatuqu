---
import { siteConfig } from '../data/siteConfig';

const faqs = [
  {
    q: 'Aman untuk suede, nubuck, dan mesh?',
    a: 'Aman. Kami cuci manual minim air dengan sikat bulu halus & cairan pH netral agar warna tidak luntur dan bulu suede tetap lembut.',
  },
  {
    q: 'Bagaimana sistem antar-jemputnya?',
    a: `Area ${siteConfig.serviceArea}. Setelah pesan via WA, admin atur jadwal jemput—bisa juga titip di satpam atau resepsionis.`,
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: 'Fast Clean 1 hari, Deep Clean 2–3 hari, Unyellowing 3 hari, Reglue 3–4 hari, dan Repaint 5–7 hari (dikeringkan blower suhu ruang).',
  },
  {
    q: 'Bayar di awal atau setelah selesai?',
    a: 'Tanpa DP untuk cuci standar. Bisa bayar setelah sepatu dicek atau saat diantar balik (transfer, QRIS, atau tunai).',
  },
  {
    q: 'Syarat garansi cuci ulang?',
    a: 'Jika masih ada noda terlewat atau bau belum hilang, kabari maks. 48 jam setelah diterima (sebelum dipakai keluar)—kami cuci ulang gratis.',
  },
];
---

<section id="lokasi-faq" class="border-t border-zinc-200 bg-white py-11 sm:py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Info Lokasi & Google Maps -->
      <div class="lg:col-span-5" data-reveal>
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
          Workshop &amp; Jam Buka
        </p>
        <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
          Mau drop-off langsung? Bisa.
        </h2>

        <dl class="mt-5 space-y-3 rounded-2xl border border-zinc-200 bg-zinc-50 p-4 text-xs sm:p-5 sm:text-sm">
          <div>
            <dt class="font-bold text-zinc-900">Jam Buka</dt>
            <dd class="mt-0.5 text-zinc-600">{siteConfig.hours}</dd>
          </div>
          <div class="border-t border-zinc-200 pt-2.5">
            <dt class="font-bold text-zinc-900">Area Jemput</dt>
            <dd class="mt-0.5 text-zinc-600">{siteConfig.serviceArea}</dd>
          </div>
          <div class="border-t border-zinc-200 pt-2.5">
            <dt class="font-bold text-zinc-900">Alamat</dt>
            <dd class="mt-0.5 text-zinc-600">{siteConfig.address}</dd>
          </div>
        </dl>

        <div class="mt-4 overflow-hidden rounded-2xl border border-zinc-200 bg-white">
          {
            siteConfig.mapsEmbedUrl ? (
              <iframe
                src={siteConfig.mapsEmbedUrl}
                title={`Peta lokasi ${siteConfig.brandName}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-48 w-full border-0 sm:h-52"
                allowfullscreen
              />
            ) : (
              <div class="flex h-44 flex-col items-center justify-center bg-zinc-100 p-5 text-center sm:h-52">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  class="h-7 w-7 text-zinc-400"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                  />
                </svg>
                <p class="mt-2 text-xs font-bold text-zinc-800 sm:text-sm">Peta Google Maps Workshop</p>
                <p class="mt-1 max-w-xs text-[11px] leading-relaxed text-zinc-500">
                  Isi <code class="rounded bg-zinc-200 px-1 py-0.5 text-zinc-800">mapsEmbedUrl</code> di <code class="rounded bg-zinc-200 px-1 py-0.5 text-zinc-800">src/data/siteConfig.ts</code>.
                </p>
              </div>
            )
          }
        </div>
      </div>

      <!-- 5 FAQ Native HTML <details> & <summary> -->
      <div class="lg:col-span-7" data-reveal style="--reveal-delay: 80ms;">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
          FAQ
        </p>
        <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
          Yang sering ditanyakan
        </h2>

        <div class="mt-5 space-y-2.5">
          {
            faqs.map((item) => (
              <details class="group rounded-2xl border border-zinc-200 bg-zinc-50 transition-colors hover:border-zinc-300 open:border-emerald-600/50 open:bg-white">
                <summary class="flex cursor-pointer items-center justify-between gap-3 px-4 py-3.5 text-left text-sm font-bold text-zinc-900 sm:px-5 sm:py-4">
                  <span>{item.q}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0 text-zinc-500 transition-transform duration-200 group-open:rotate-180 group-open:text-emerald-600"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </summary>
                <div class="border-t border-zinc-100 px-4 pt-2.5 pb-3.5 text-xs leading-relaxed text-zinc-600 sm:px-5 sm:text-sm">
                  {item.a}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
