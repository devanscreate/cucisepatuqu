---
import { siteConfig } from '../data/siteConfig';

const faqs = [
  {
    q: 'Apakah aman untuk sepatu bahan suede, nubuck, dan mesh?',
    a: 'Aman. Kami tidak merendam sepatu berbahan suede atau nubuck. Pembersihan dilakukan manual dengan sikat bulu lembut (soft brush) dan cairan pembersih pH netral agar warna tidak luntur dan bulu suede tetap halus.',
  },
  {
    q: 'Bagaimana sistem antar-jemput dan ongkirnya?',
    a: `Layanan antar-jemput mencakup area ${siteConfig.serviceArea}. Setelah kamu kirim form pesanan di WhatsApp, admin akan konfirmasi jadwal penjemputan dan info ongkir sesuai jarak (gratis jemput untuk radius tertentu atau minimal order 2 pasang).`,
  },
  {
    q: 'Berapa lama proses pengerjaan sampai sepatu kembali?',
    a: 'Fast Clean selesai dalam 1 hari kerja, Deep Clean 2–3 hari, Unyellowing 3 hari, Reglue 3–4 hari, dan Repaint 5–7 hari. Sepatu dikeringkan secara alami dengan blower suhu ruang—bukan dijemur matahari langsung—agar lem tidak cepat rusak.',
  },
  {
    q: 'Kapan pembayaran dilakukan?',
    a: 'Pembayaran bisa dilakukan setelah sepatu kami terima dan dicek kondisinya, atau saat sepatu diantar kembali (transfer bank / QRIS / tunai). Untuk layanan Repaint atau Reglue berat, admin akan mengonfirmasi estimasi biaya pastinya dulu sebelum dikerjakan.',
  },
  {
    q: 'Apa syarat garansi cuci ulang?',
    a: 'Jika saat diterima masih ada noda yang terlewat atau bau belum hilang, kabari kami maksimal 2×24 jam setelah sepatu diterima (sebelum dipakai keluar rumah). Kami cuci ulang tanpa biaya tambahan.',
  },
];
---

<section id="lokasi-faq" class="border-t border-zinc-200 bg-zinc-50 py-14 sm:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- Info Lokasi & Google Maps -->
      <div class="lg:col-span-5">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
          Workshop &amp; Jam Buka
        </p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
          Mau drop-off langsung? Bisa.
        </h2>

        <dl class="mt-6 space-y-4 rounded-2xl border border-zinc-200 bg-white p-5 text-sm">
          <div>
            <dt class="font-bold text-zinc-900">Jam Operasional</dt>
            <dd class="mt-0.5 text-zinc-600">{siteConfig.hours}</dd>
          </div>
          <div class="border-t border-zinc-100 pt-3">
            <dt class="font-bold text-zinc-900">Area Antar-Jemput</dt>
            <dd class="mt-0.5 text-zinc-600">{siteConfig.serviceArea}</dd>
          </div>
          <div class="border-t border-zinc-100 pt-3">
            <dt class="font-bold text-zinc-900">Alamat Workshop</dt>
            <dd class="mt-0.5 text-zinc-600">{siteConfig.address}</dd>
          </div>
        </dl>

        <!-- Slot Embed Google Maps -->
        <div class="mt-5 overflow-hidden rounded-2xl border border-zinc-200 bg-white">
          {
            siteConfig.mapsEmbedUrl ? (
              <iframe
                src={siteConfig.mapsEmbedUrl}
                title={`Peta lokasi ${siteConfig.brandName}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="h-56 w-full border-0"
                allowfullscreen
              />
            ) : (
              <div class="flex h-56 flex-col items-center justify-center bg-zinc-100 p-6 text-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  class="h-8 w-8 text-zinc-400"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                  />
                </svg>
                <p class="mt-2 text-sm font-bold text-zinc-800">Peta Google Maps Workshop</p>
                <p class="mt-1 max-w-xs text-xs leading-relaxed text-zinc-500">
                  Isi <code class="rounded bg-zinc-200 px-1 py-0.5 text-zinc-800">mapsEmbedUrl</code> di <code class="rounded bg-zinc-200 px-1 py-0.5 text-zinc-800">src/data/siteConfig.ts</code> untuk menampilkan peta interaktif di sini.
                </p>
              </div>
            )
          }
        </div>
      </div>

      <!-- 5 FAQ Native HTML <details> & <summary> -->
      <div class="lg:col-span-7">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
          Pertanyaan Umum
        </p>
        <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
          Yang sering ditanyakan
        </h2>

        <div class="mt-6 space-y-3">
          {
            faqs.map((item) => (
              <details class="group rounded-2xl border border-zinc-200 bg-white">
                <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left text-sm font-bold text-zinc-900 sm:text-base">
                  <span>{item.q}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0 text-zinc-500 transition-transform duration-200 group-open:rotate-180"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </summary>
                <div class="border-t border-zinc-100 px-5 pt-3 pb-4 text-sm leading-relaxed text-zinc-600">
                  {item.a}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
