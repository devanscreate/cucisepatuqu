---
import { services } from '../data/services';

const materials = [
  {
    id: 'suede',
    label: 'Suede & Nubuck',
    care: 'Cuci minim air pakai sikat bulu halus + pH netral, bulu tetap lembut.',
    avoid: 'Tanpa direndam & tanpa jemur matahari.',
  },
  {
    id: 'mesh',
    label: 'Mesh / Lari',
    care: 'Sikat halus searah serat jaring + deodorizer anti-bakteri.',
    avoid: 'Tanpa sikat keras agar pori mesh tidak berbulu.',
  },
  {
    id: 'canvas',
    label: 'Canvas / Putih',
    care: 'Deep scrubbing bertahap dengan sabun khusus kain bebas kuning.',
    avoid: 'Tanpa pemutih klorin yang bikin kain rapuh.',
  },
  {
    id: 'leather',
    label: 'Kulit / Leather',
    care: 'Microfiber + foam khusus kulit & pelembap ringan.',
    avoid: 'Tanpa deterjen keras yang bikin kulit retak.',
  },
];

const issues = [
  { id: 'light', label: 'Kotor Ringan', serviceId: 'fast-clean' },
  { id: 'heavy', label: 'Kotor Berat & Bau', serviceId: 'deep-clean' },
  { id: 'yellow', label: 'Midsole Kuning', serviceId: 'unyellowing' },
  { id: 'sole', label: 'Sol / Lem Lepas', serviceId: 'reglue' },
  { id: 'faded', label: 'Warna Pudar', serviceId: 'repaint' },
];

const defaultMaterial = materials[0];
const defaultIssue = issues[1];
const defaultService = services.find((s) => s.id === defaultIssue.serviceId) ?? services[1];

const diagnosisPayload = JSON.stringify({
  materials,
  issues,
  services: services.map((s) => ({
    id: s.id,
    name: s.name,
    priceLabel: s.priceLabel,
    eta: s.eta,
  })),
});
---

<section id="diagnosa" class="bg-white py-11 sm:py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="max-w-lg" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Diagnosa 10 Detik
      </p>
      <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
        Bingung pilih paket? Cek di sini
      </h2>
      <p class="mt-1.5 text-sm text-zinc-600">
        Tap bahan &amp; kondisi sepatumu—langsung ketemu paket paling pas.
      </p>
    </div>

    <div
      id="diagnosis-widget"
      data-payload={diagnosisPayload}
      data-reveal
      style="--reveal-delay: 80ms;"
      class="mt-6 grid grid-cols-1 gap-5 rounded-2xl border border-zinc-200 bg-zinc-50 p-4 sm:p-6 lg:grid-cols-12"
    >
      <!-- Pilihan Bahan & Kondisi -->
      <div class="space-y-5 lg:col-span-7">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-500">
            1. Bahan Sepatu
          </p>
          <div class="mt-2 grid grid-cols-2 gap-2 sm:flex sm:flex-wrap" role="group" aria-label="Pilih bahan sepatu">
            {
              materials.map((mat) => (
                <button
                  type="button"
                  data-diag-material={mat.id}
                  aria-pressed={mat.id === defaultMaterial.id ? 'true' : 'false'}
                  class:list={[
                    'cursor-pointer rounded-xl border px-3 py-2.5 text-xs font-semibold transition-all active:scale-[0.98] sm:px-3.5 sm:text-sm',
                    mat.id === defaultMaterial.id
                      ? 'border-emerald-600 bg-emerald-600 text-white'
                      : 'border-zinc-300 bg-white text-zinc-800 hover:border-zinc-400 hover:bg-zinc-100',
                  ]}
                >
                  {mat.label}
                </button>
              ))
            }
          </div>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-500">
            2. Kondisi Saat Ini
          </p>
          <div class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Pilih kondisi sepatu">
            {
              issues.map((issue) => (
                <button
                  type="button"
                  data-diag-issue={issue.id}
                  aria-pressed={issue.id === defaultIssue.id ? 'true' : 'false'}
                  class:list={[
                    'cursor-pointer rounded-xl border px-3 py-2 text-xs font-semibold transition-all active:scale-[0.98] sm:px-3.5 sm:text-sm',
                    issue.id === defaultIssue.id
                      ? 'border-zinc-900 bg-zinc-900 text-white'
                      : 'border-zinc-300 bg-white text-zinc-800 hover:border-zinc-400 hover:bg-zinc-100',
                  ]}
                >
                  {issue.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Hasil Rekomendasi -->
      <div class="lg:col-span-5">
        <div
          id="diag-result-card"
          data-tilt
          class="flex h-full flex-col justify-between rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm hover:shadow-md sm:p-5"
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-bold text-emerald-700">
                Rekomendasi
              </span>
              <span id="diag-eta" class="text-xs font-semibold text-zinc-500">
                {defaultService.eta}
              </span>
            </div>

            <div class="mt-2.5 flex items-baseline justify-between gap-2">
              <h3 id="diag-service-name" class="text-lg font-extrabold text-zinc-900 sm:text-xl">
                {defaultService.name}
              </h3>
              <span id="diag-service-price" class="text-base font-extrabold text-emerald-600 sm:text-lg">
                {defaultService.priceLabel}
              </span>
            </div>

            <div class="mt-3 space-y-2 border-t border-zinc-100 pt-3 text-xs leading-relaxed sm:text-sm">
              <p id="diag-care" class="text-zinc-700">{defaultMaterial.care}</p>
              <p class="rounded-lg bg-zinc-50 px-2.5 py-2 text-xs text-zinc-600">
                <strong class="text-zinc-900">Aman:</strong> <span id="diag-avoid">{defaultMaterial.avoid}</span>
              </p>
            </div>
          </div>

          <button
            type="button"
            id="diag-apply-btn"
            data-burst
            class="mt-4 inline-flex min-h-11 w-full cursor-pointer items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white shadow-xs transition-all hover:bg-emerald-700 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
          >
            Pakai Rekomendasi Ini
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  interface DiagMaterial {
    id: string;
    label: string;
    care: string;
    avoid: string;
  }
  interface DiagIssue {
    id: string;
    label: string;
    serviceId: string;
  }
  interface DiagService {
    id: string;
    name: string;
    priceLabel: string;
    eta: string;
  }
  interface DiagPayload {
    materials: DiagMaterial[];
    issues: DiagIssue[];
    services: DiagService[];
  }

  const widget = document.getElementById('diagnosis-widget');
  if (widget && widget.dataset.payload) {
    const data = JSON.parse(widget.dataset.payload) as DiagPayload;
    let activeMaterialId = 'suede';
    let activeIssueId = 'heavy';

    const matBtns = widget.querySelectorAll<HTMLButtonElement>('[data-diag-material]');
    const issueBtns = widget.querySelectorAll<HTMLButtonElement>('[data-diag-issue]');
    const serviceNameEl = document.getElementById('diag-service-name');
    const servicePriceEl = document.getElementById('diag-service-price');
    const etaEl = document.getElementById('diag-eta');
    const careEl = document.getElementById('diag-care');
    const avoidEl = document.getElementById('diag-avoid');
    const resultCard = document.getElementById('diag-result-card');
    const applyBtn = document.getElementById('diag-apply-btn');

    const render = () => {
      const mat = data.materials.find((m) => m.id === activeMaterialId) ?? data.materials[0];
      const issue = data.issues.find((i) => i.id === activeIssueId) ?? data.issues[1];
      const service = data.services.find((s) => s.id === issue.serviceId) ?? data.services[1];

      matBtns.forEach((btn) => {
        const isActive = btn.dataset.diagMaterial === activeMaterialId;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.classList.toggle('border-emerald-600', isActive);
        btn.classList.toggle('bg-emerald-600', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('border-zinc-300', !isActive);
        btn.classList.toggle('bg-white', !isActive);
        btn.classList.toggle('text-zinc-800', !isActive);
      });

      issueBtns.forEach((btn) => {
        const isActive = btn.dataset.diagIssue === activeIssueId;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.classList.toggle('border-zinc-900', isActive);
        btn.classList.toggle('bg-zinc-900', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('border-zinc-300', !isActive);
        btn.classList.toggle('bg-white', !isActive);
        btn.classList.toggle('text-zinc-800', !isActive);
      });

      if (serviceNameEl) serviceNameEl.textContent = service.name;
      if (servicePriceEl) servicePriceEl.textContent = service.priceLabel;
      if (etaEl) etaEl.textContent = service.eta;
      if (careEl) careEl.textContent = mat.care;
      if (avoidEl) avoidEl.textContent = mat.avoid;

      if (resultCard) {
        resultCard.classList.remove('is-highlighted');
        void resultCard.offsetWidth;
        resultCard.classList.add('is-highlighted');
      }
    };

    matBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeMaterialId = btn.dataset.diagMaterial ?? activeMaterialId;
        render();
      });
    });

    issueBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeIssueId = btn.dataset.diagIssue ?? activeIssueId;
        render();
      });
    });

    applyBtn?.addEventListener('click', () => {
      const mat = data.materials.find((m) => m.id === activeMaterialId) ?? data.materials[0];
      const issue = data.issues.find((i) => i.id === activeIssueId) ?? data.issues[1];

      window.dispatchEvent(
        new CustomEvent('kicksclean:prefill', {
          detail: {
            serviceId: issue.serviceId,
            notes: `Bahan: ${mat.label} — Kondisi: ${issue.label}`,
          },
        })
      );

      document.getElementById('booking')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    });
  }
</script>
