---
interface ComparisonCase {
  id: string;
  title: string;
  treatment: string;
  note: string;
  beforeImage: string;
  afterImage: string;
  beforeAlt: string;
  afterAlt: string;
}

/**
 * PANDUAN GANTI FOTO ASLI:
 * Simpan foto hasil pengerjaan berformat .webp di folder `public/images/`
 * (rekomendasi rasio 3:2, misal 900x600px, ukuran < 120KB per foto).
 * Lalu ganti path `.svg` di bawah menjadi path `.webp` Anda.
 */
const cases: ComparisonCase[] = [
  {
    id: 'kanvas',
    title: 'Sneakers Kanvas Putih',
    treatment: 'Deep Clean + Unyellowing',
    note: 'Noda lumpur & midsole kusam kembali cerah.',
    beforeImage: '/images/kanvas-before.svg', // Ganti ke /images/kanvas-before.webp
    afterImage: '/images/kanvas-after.svg',   // Ganti ke /images/kanvas-after.webp
    beforeAlt: 'Sneakers kanvas putih kotor sebelum dicuci',
    afterAlt: 'Sneakers kanvas putih bersih sesudah dicuci',
  },
  {
    id: 'mesh',
    title: 'Sepatu Lari Mesh',
    treatment: 'Deep Clean',
    note: 'Debu pori mesh & bau keringat hilang, serat tetap utuh.',
    beforeImage: '/images/mesh-before.svg', // Ganti ke /images/mesh-before.webp
    afterImage: '/images/mesh-after.svg',   // Ganti ke /images/mesh-after.webp
    beforeAlt: 'Sepatu lari bahan mesh berdebu sebelum dicuci',
    afterAlt: 'Sepatu lari bahan mesh bersih sesudah dicuci',
  },
  {
    id: 'suede',
    title: 'Sneakers Bahan Suede',
    treatment: 'Deep Clean Suede',
    note: 'Warna rata tanpa luntur, bulu suede kembali halus.',
    beforeImage: '/images/suede-before.svg', // Ganti ke /images/suede-before.webp
    afterImage: '/images/suede-after.svg',   // Ganti ke /images/suede-after.webp
    beforeAlt: 'Sepatu bahan suede bernoda air sebelum dicuci',
    afterAlt: 'Sepatu bahan suede bersih dan rata sesudah dicuci',
  },
];
---

<section id="hasil" class="border-t border-zinc-200 bg-zinc-50 py-11 sm:py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="max-w-lg" data-reveal>
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-600">
        Bukti Pengerjaan
      </p>
      <h2 class="mt-1.5 text-2xl font-extrabold tracking-tight text-zinc-900 sm:text-3xl">
        Geser untuk lihat bedanya
      </h2>
      <p class="mt-1.5 text-sm text-zinc-600">
        Tarik garis tengah ke kiri atau kanan.
      </p>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
      {
        cases.map((item, idx) => (
          <article
            data-reveal
            style={`--reveal-delay: ${idx * 80}ms;`}
            class="flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-emerald-600/50 hover:shadow-md"
          >
            <div
              class="ba-slider relative aspect-[3/2] w-full overflow-hidden bg-zinc-100 select-none"
              data-ba-container
              data-ba-demo={idx === 0 ? 'true' : undefined}
            >
              <img
                src={item.afterImage}
                alt={item.afterAlt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="pointer-events-none h-full w-full object-cover"
              />

              <div
                data-ba-before
                class="pointer-events-none absolute inset-0"
                style="clip-path: inset(0 50% 0 0);"
              >
                <img
                  src={item.beforeImage}
                  alt={item.beforeAlt}
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>

              <span class="pointer-events-none absolute top-2.5 left-2.5 rounded-md bg-zinc-900/85 px-2 py-0.5 text-[11px] font-bold tracking-wide text-white">
                Sebelum
              </span>
              <span class="pointer-events-none absolute top-2.5 right-2.5 rounded-md bg-emerald-600 px-2 py-0.5 text-[11px] font-bold tracking-wide text-white">
                Sesudah
              </span>

              <div
                data-ba-divider
                class="pointer-events-none absolute inset-y-0 w-0.5 bg-white"
                style="left: 50%;"
              >
                <div class="absolute top-1/2 left-1/2 flex h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-300 bg-white text-zinc-900 shadow-sm">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-4 w-4"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M12.79 5.23a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L16.44 10l-3.65-3.72a.75.75 0 0 1 0-1.05Zm-5.58 0a.75.75 0 0 1 0 1.05L3.56 10l3.65 3.72a.75.75 0 1 1-1.06 1.06L1.9 10.53a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
              </div>

              <input
                type="range"
                min="0"
                max="100"
                value="50"
                data-ba-input
                aria-label={`Geser perbandingan sebelum dan sesudah untuk ${item.title}`}
                class="ba-range absolute inset-0 z-10 h-full w-full"
              />
            </div>

            <div class="p-4">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-bold text-zinc-900 sm:text-base">{item.title}</h3>
              </div>
              <p class="mt-0.5 text-xs font-semibold text-emerald-700">{item.treatment}</p>
              <p class="mt-1.5 text-xs leading-relaxed text-zinc-600 sm:text-sm">{item.note}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const containers = document.querySelectorAll<HTMLElement>('[data-ba-container]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  containers.forEach((container) => {
    const input = container.querySelector<HTMLInputElement>('[data-ba-input]');
    const beforeLayer = container.querySelector<HTMLElement>('[data-ba-before]');
    const divider = container.querySelector<HTMLElement>('[data-ba-divider]');

    if (!input || !beforeLayer || !divider) return;

    let demoCancelled = false;

    const setVisual = (value: number) => {
      const clamped = Math.max(0, Math.min(100, value));
      const rightInset = 100 - clamped;
      beforeLayer.style.clipPath = `inset(0 ${rightInset}% 0 0)`;
      divider.style.left = `${clamped}%`;
      input.value = String(Math.round(clamped));
    };

    const stopDemo = () => {
      demoCancelled = true;
    };

    input.addEventListener('pointerdown', stopDemo, { passive: true });
    input.addEventListener('touchstart', stopDemo, { passive: true });
    input.addEventListener('keydown', stopDemo);
    input.addEventListener('input', () => {
      demoCancelled = true;
      setVisual(Number(input.value));
    });
    input.addEventListener('change', () => setVisual(Number(input.value)));

    setVisual(Number(input.value));

    if (
      container.dataset.baDemo === 'true' &&
      !prefersReducedMotion &&
      'IntersectionObserver' in window
    ) {
      let hasRun = false;
      const demoObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting || hasRun || demoCancelled) return;
            hasRun = true;
            obs.unobserve(container);

            const duration = 1800;
            const startTime = performance.now();

            const animate = (now: number) => {
              if (demoCancelled) return;
              const progress = Math.min((now - startTime) / duration, 1);
              const wave = Math.sin(progress * Math.PI * 2);
              const val = 50 + wave * 24;
              setVisual(val);

              if (progress < 1) {
                requestAnimationFrame(animate);
              } else {
                setVisual(50);
              }
            };

            setTimeout(() => {
              if (!demoCancelled) requestAnimationFrame(animate);
            }, 350);
          });
        },
        { threshold: 0.45 }
      );

      demoObserver.observe(container);
    }
  });
</script>
